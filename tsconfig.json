{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDirs": [
      "packs/energy",
      "packs/o11y",
      "."
    ]
  },
  "include": [
    "packs/**/*.tsx",
    "charts/**/*.tsx",
    "packs/**/open-dashboard.config.ts"
  ]
}
